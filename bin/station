#!/usr/bin/env bash
set -euo pipefail

root=${STATION_ROOT:-/usr/local/lib/station}
[ -d "$root" ] || root=/opt/station/current
command=${1:-status}
shift || true

case "$command" in
  doctor|status)
    exec python3 "$root/scripts/doctor.py" "$@"
    ;;
  tui)
    exec /usr/local/bin/agk "$@"
    ;;
  portal)
    if [ -n "${STATION_PORTAL_URL:-}" ]; then
      printf '%s\n' "$STATION_PORTAL_URL"
    elif command -v tailscale >/dev/null 2>&1; then
      tailscale status --json | python3 -c 'import json,sys; name=str((json.load(sys.stdin).get("Self") or {}).get("DNSName") or "").rstrip("."); print("https://"+name+"/" if name else "http://127.0.0.1:8459/")'
    else
      printf '%s\n' 'http://127.0.0.1:8459/'
    fi
    ;;
  discord)
    subcommand=${1:-}; shift || true
    [ "$subcommand" = token ] || { echo "usage: sudo station discord token {list|check TARGET|rotate TARGET}" >&2; exit 2; }
    [ "$(id -u)" -eq 0 ] || { echo "Discord token management requires sudo" >&2; exit 1; }
    exec /usr/local/lib/agk-terminal/venv/bin/python \
      /usr/local/lib/agk-terminal/scripts/rotate_discord_token.py "$@"
    ;;
  gateway)
    action=${1:-}; target=${2:-}; shift 2 || true
    [ "$action" = safe-reload ] || { echo "usage: sudo station gateway safe-reload TARGET" >&2; exit 2; }
    [ "$(id -u)" -eq 0 ] || { echo "Safe gateway reload requires sudo" >&2; exit 1; }
    case "$target" in
      operator) user=operator; unit=hermes-gateway.service; home=/home/operator/.hermes ;;
      agentik) user=agentik; unit=hermes-gateway.service; home=/home/agentik/.hermes ;;
      mission) user=mission; unit=hermes-gateway.service; home=/home/mission/.hermes ;;
      private) user=private; unit=hermes-gateway.service; home=/home/private/.hermes ;;
      collective) user=agentik; unit=hermes-gateway-collective.service; home=/home/agentik/.hermes/profiles/collective ;;
      nutrition-os) user=private; unit=hermes-gateway-nutrition-os.service; home=/home/private/.hermes/profiles/nutrition-os ;;
      dentistrygpt) user=mission; unit=hermes-gateway-clientdentistrygptee881c.service; home=/home/mission/.hermes/profiles/clientdentistrygptee881c ;;
      *) echo "unknown gateway target" >&2; exit 2 ;;
    esac
    exec /usr/local/lib/agk-terminal/venv/bin/python /usr/local/lib/agk-terminal/scripts/station_safe_gateway_reload.py --user "$user" --unit "$unit" --hermes-home "$home" "$@"
    ;;
  completion)
    exec /usr/local/lib/agk-terminal/venv/bin/python \
      /usr/local/lib/agk-terminal/scripts/completion_harness.py \
      --root "${HERMES_HOME:-$HOME/.hermes}/completion" "$@"
    ;;
  recovery)
    action=${1:-audit}; shift || true
    case "$action" in
      audit)
        if [ "$(id -u)" -eq 0 ]; then
          exec /usr/local/lib/agk-terminal/venv/bin/python /usr/local/lib/agk-terminal/scripts/fleet_recovery_auditor.py "$@"
        fi
        exec /usr/local/lib/agk-terminal/venv/bin/python /usr/local/lib/agk-terminal/scripts/recovery_auditor.py \
          --profile "${STATION_PROFILE:-$(id -un)}" --state-db "${HERMES_HOME:-$HOME/.hermes}/state.db" \
          --completion-root "${HERMES_HOME:-$HOME/.hermes}/completion" --reports-root "${HERMES_HOME:-$HOME/.hermes}/reports" "$@"
        ;;
      baseline)
        [ "$(id -u)" -eq 0 ] || { echo "Fleet baseline requires sudo" >&2; exit 1; }
        exec /usr/local/lib/agk-terminal/venv/bin/python /usr/local/lib/agk-terminal/scripts/fleet_recovery_auditor.py --baseline "$@"
        ;;
      decide)
        [ "$(id -u)" -eq 0 ] || { echo "Recovery decisions require sudo" >&2; exit 1; }
        exec /usr/local/lib/agk-terminal/venv/bin/python /usr/local/lib/agk-terminal/scripts/recovery_router.py "$@"
        ;;
      approve)
        [ "$(id -u)" -eq 0 ] || { echo "Human approval evidence requires sudo" >&2; exit 1; }
        exec /usr/local/lib/agk-terminal/venv/bin/python /usr/local/lib/agk-terminal/scripts/approval_gate.py "$@"
        ;;
      oracle-pass)
        [ "$(id -u)" -eq 0 ] || { echo "Completion Oracle evidence requires sudo" >&2; exit 1; }
        exec /usr/local/lib/agk-terminal/venv/bin/python /usr/local/lib/agk-terminal/scripts/completion_oracle_gate.py "$@"
        ;;
      report)
        exec python3 -m json.tool /var/lib/station/recovery/index.json
        ;;
      *) echo "usage: station recovery {audit|baseline|report|decide|oracle-pass} ..." >&2; exit 2 ;;
    esac
    ;;
  durability)
    exec python3 "$root/overlay/scripts/station_durability.py" "$@"
    ;;
  backup)
    [ "$(id -u)" -eq 0 ] || { echo "Station backup requires sudo" >&2; exit 1; }
    exec python3 "$root/scripts/backup.py" "$@"
    ;;
  update)
    [ "$(id -u)" -eq 0 ] || { echo "Station update requires sudo" >&2; exit 1; }
    exec bash "$root/scripts/update.sh" "$@"
    ;;
  rollback)
    [ "$(id -u)" -eq 0 ] || { echo "Station rollback requires sudo" >&2; exit 1; }
    exec bash "$root/scripts/rollback.sh" "$@"
    ;;
  version)
    python3 -c "import yaml; print(yaml.safe_load(open('$root/station.yaml'))['product']['version'])"
    ;;
  help|-h|--help)
    cat <<'EOF'
Station · portable Discord + Hermes + AGK-TUI + Portal platform

  station status|doctor
  station tui
  station portal
  sudo station discord token list
  sudo station discord token check TARGET
  sudo station discord token rotate TARGET
  sudo station gateway safe-reload {operator|agentik|mission|private|collective|nutrition-os|dentistrygpt}
  station completion {archive-prompt|gate} ...
  station recovery audit
  sudo station recovery baseline
  station recovery report
  sudo station recovery decide FINDING {RELAUNCH|BACKLOG|IGNORE|ALREADY_DONE} --actor NAME --source SOURCE
  sudo station recovery approve PROFILE MISSION REQUIREMENT --actor NAME --source discord --scope production
  sudo station recovery oracle-pass PROFILE MISSION REPORT.json --actor completion-oracle
  station durability {profile-audit|memory-audit|cron-audit|fresh-session-gate|isolated-pilot|checkpoint-command} ...
  sudo station backup
  sudo station update [--ref REF]
  sudo station rollback [RELEASE]
  station version
EOF
    ;;
  *) echo "unknown Station command: $command" >&2; exit 2 ;;
esac
