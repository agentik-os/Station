[Unit]
Description=Generate and publish the weekday AGK News digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/home/mission
Environment=HERMES_HOME=/home/mission/.hermes/profiles/collective
Environment=PATH=/opt/agk-terminal/hermes-agent/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /usr/local/lib/agk-terminal/scripts/collective_news_digest.py
TimeoutStartSec=720
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mission/.hermes/profiles/collective
LockPersonality=true
