[Unit]
Description=Publish new agentik-os GitHub Stars to Collective Discord forum
After=network-online.target hermes-gateway-collective.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/mission/.hermes/profiles/collective
ExecStart=/usr/local/lib/agk-terminal/scripts/github_stars_forum_watcher.py --profile-home /home/mission/.hermes/profiles/collective
NoNewPrivileges=true
PrivateTmp=true
