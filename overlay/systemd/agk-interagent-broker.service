[Unit]
Description=AGK Station inter-agent broker
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/lib/agk-terminal/venv/bin/python /usr/local/lib/agk-terminal/scripts/station_interagent_broker.py
Restart=on-failure
RestartSec=3
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/operator/.hermes /home/agentik/.hermes /home/mission/.hermes /home/private/.hermes
RuntimeDirectory=agk-station
RuntimeDirectoryMode=0755
StateDirectory=agk-station
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
